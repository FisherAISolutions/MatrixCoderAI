# Matrix Coder AI environment example
# Never commit real secrets. Copy this file to .env.local for local development.

# Supabase browser client (optional; app falls back to local/session storage if missing)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI provider keys (server-only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Vercel deployment integration (server-only token plus browser-safe configured flag)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
NEXT_PUBLIC_VERCEL_TOKEN_CONFIGURED=false

# Trusted Supabase server access for billing, usage, and webhook writes
SUPABASE_SERVICE_ROLE_KEY=

# Stripe subscriptions (server-only; use test-mode values before private beta)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Trusted application origin used for Stripe return URLs
MATRIX_APP_BASE_URL=http://localhost:3000

# Local development: disabled. Private beta: enforced. Operator testing: internal.
MATRIX_BILLING_MODE=disabled

# Comma-separated Supabase user UUIDs only; never use email addresses here.
MATRIX_INTERNAL_USER_IDS=

# Private-beta access. Production defaults to controlled if omitted.
# open | controlled | closed
MATRIX_BETA_ACCESS_MODE=controlled
# Comma-separated email allowlist used only when access mode is controlled.
MATRIX_BETA_ALLOWED_EMAILS=
# Optional public links shown in the application shell and support surfaces.
MATRIX_BETA_FEEDBACK_URL=
MATRIX_STATUS_PAGE_URL=

# Emergency operator controls
MATRIX_DISABLE_AI=false
MATRIX_DISABLE_TASK_BUILDS=false
MATRIX_DISABLE_DEPLOYMENT=false
MATRIX_DISABLE_CHECKOUT=false

# Optional secret-safe error reporting adapter
MATRIX_ERROR_REPORTING_URL=
MATRIX_ERROR_REPORTING_TOKEN=
